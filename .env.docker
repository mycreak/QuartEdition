# ═══════════════════════════════════════════════════════════════
# QuartEdition — Docker 环境 .env 配置
#
# 使用方式：
#   1. 复制此文件为 .env（docker compose 自动读取）
#      cp .env.docker .env
#   2. 修改密钥和密码
#   3. docker compose up -d
#
# ⚠️ 安全提醒：
#   JWT_SECRET 和所有 PASSWORD 必须修改为强随机值！
#   生产环境建议通过系统环境变量注入，不落地 .env 文件
# ═══════════════════════════════════════════════════════════════

# ── JWT（生产环境必须修改！用 openssl rand -hex 32 生成） ──
JWT_SECRET=change-this-to-a-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=604800

# ── MySQL ──
MYSQL_PASSWORD=StrongMySQLPass123!
MYSQL_DATABASE=movie_db

# ── Redis ──
REDIS_PASSWORD=StrongRedisPass123!

# ── MongoDB ──
MONGO_USER=root
MONGO_PASSWORD=StrongMongoPass123!
MONGO_DATABASE=movie_db

# ── 服务端口（对外暴露） ──
BACKEND_PORT=8000
FRONTEND_PORT=80

# ── Snowflake 机器 ID（多副本部署时每实例不同，0~1023） ──
SNOWFLAKE_MACHINE_ID=1

# ── 日志 ──
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── DeepSeek AI 词云（可选，不填则禁用） ──
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1/chat/completions

# ── 火山引擎 TOS 图床（可选，不填则上传失败但不影响启动） ──
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=tos-cn-guangzhou.volces.com
TOS_REGION=cn-guangzhou
TOS_BUCKET=movie-poster

# ── WebSocket URL（前端构建时注入，生产环境改为 wss://你的域名/ws/notifications） ──
VITE_WS_URL=ws://localhost:8000/ws/notifications

# ── 付费代理种子（可选，格式: host:port:user:pass,host:port:user:pass） ──
PAID_PROXIES=
