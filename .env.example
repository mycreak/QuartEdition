# QuartEdition 环境变量配置
#
# 复制此文件为 .env 并根据实际环境修改
# 优先级：系统环境变量 > .env > 代码默认值
#
# 生产环境必须修改 JWT_SECRET 和所有 PASSWORD 字段！

# ── JWT ──
JWT_SECRET=quart-edition-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=604800

# ── Bcrypt ──
BCRYPT_ROUNDS=12

# ── MySQL ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=movie_db

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0

# ── MongoDB ──
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=123456
MONGO_DATABASE=movie_db
